rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пользователи
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Занятия
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list &&
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Записи на занятия
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // Настройки приложения
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Сообщения администратору
    match /admin_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null;
    }

    // FCM токены — request.resource.data для create, resource.data для read/update/delete
    match /fcm_tokens/{tokenId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Вспомогательная функция: проверка роли admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list &&
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Типы абонементов — читают все авторизованные, пишет только админ
    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Абонементы пользователей
    match /userSubscriptions/{subscriptionId} {
      // Пользователь видит только свои; админ видит все
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Пользователь создаёт абонемент на себя; админ — на любого пользователя
      allow create: if request.auth != null &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      // Обновление:
      // - Пользователь может обновлять только свой абонемент
      //   (списание/возврат визитов при записи/отмене занятия)
      // - Админ может обновлять любой абонемент (оплата, смена плана, продление)
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if isAdmin();
    }
  }
}
